<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glow Circle (Center 54, 54, radius 28dp, safe within 66dp zone) -->
    <path
        android:pathData="M 54,26 A 28,28 0 1,1 53.9,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#26FFFFFF" />
                <item android:offset="1.0" android:color="#0D000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Coin / Badge (Radius 25dp) -->
    <path
        android:pathData="M 54,29 A 25,25 0 1,1 53.9,29 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="29"
                android:endX="76"
                android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#10B981" />
                <item android:offset="1.0" android:color="#059669" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coin Ring Border -->
    <path
        android:pathData="M 54,32 A 22,22 0 1,1 53.9,32 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#6EE7B7"
        android:fillColor="#00000000" />

    <!-- Indian Rupee Sign (₹) Geometry inside center (approx 54, 54) -->
    <!-- Top horizontal bar -->
    <path
        android:pathData="M44,43 L64,43"
        android:strokeWidth="2.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Second horizontal bar -->
    <path
        android:pathData="M44,48.5 L64,48.5"
        android:strokeWidth="2.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Upper loop of R -->
    <path
        android:pathData="M48,43 L48,54 C54,54 59,54 59,48.5 C59,43 54,43 48,43"
        android:strokeWidth="2.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Downward diagonal leg -->
    <path
        android:pathData="M48,54 L62,67"
        android:strokeWidth="2.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Vertical spine continuation down to leg start -->
    <path
        android:pathData="M48,43 L48,55"
        android:strokeWidth="2.8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
